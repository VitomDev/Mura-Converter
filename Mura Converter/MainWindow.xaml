<Window x:Class="Mura_Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mura Converter"
        Icon="appicon.ico"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="#111111"
        FontFamily="Bahnschrift"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        Activated="Window_Activated"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111111"/>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="InputBrush" Color="#171717"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="StatusBrush" Color="#191919"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#353535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Path Margin="0,0,10,0"
                                              Width="8"
                                              Height="5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{TemplateBinding Foreground}"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboRoot" Property="BorderBrush" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource SecondaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6B2B2B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="AccentBrush" Color="#E5484D"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#F2555A"/>

        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Format"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegRoot" CornerRadius="6" Background="Transparent" Margin="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegRoot" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegRoot" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                                <Path x:Name="Mark" Data="M 3 8 L 6.5 11.5 L 13 4.5" Stroke="White" StrokeThickness="2"
                                      Visibility="Collapsed" Margin="-1"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5A5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="34"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Source="appicon.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Mura Converter"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="MinimizeWindow_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseWindowButtonStyle}" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="14">
                <!-- Link -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" KeyDown="UrlBox_KeyDown" TextChanged="UrlBox_TextChanged"
                             ToolTip="Enlace de YouTube, TikTok, Instagram, X, Twitch, SoundCloud…"/>
                    <Button x:Name="PasteButton"
                            Grid.Column="1"
                            Width="70"
                            Height="38"
                            Margin="8,0,0,0"
                            Content="Pegar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Paste_Click"/>
                </Grid>

                <!-- Preview -->
                <Border x:Name="PreviewCard"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        CornerRadius="7"
                        Background="{StaticResource StatusBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="54" CornerRadius="5" Background="#222222" ClipToBounds="True" VerticalAlignment="Top">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewMeta" Margin="0,3,0,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <CheckBox x:Name="PlaylistOption" Margin="0,6,0,0" Visibility="Collapsed" Style="{StaticResource DarkCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Options -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tipo" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border Margin="0,6,0,0" Height="36" CornerRadius="7"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="VideoOption" Content="Vídeo" Style="{StaticResource SegmentStyle}" Checked="Kind_Changed"/>
                                <RadioButton x:Name="AudioOption" Content="Audio" Style="{StaticResource SegmentStyle}" Checked="Kind_Changed"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AudioFormatPanel" Grid.Column="1" Width="100" Margin="12,0,0,0">
                        <TextBlock Text="Formato" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="AudioFormatSelector" Margin="0,6,0,0" SelectionChanged="AudioFormat_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock x:Name="QualityLabel" Text="Calidad" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="QualitySelector" Margin="0,6,0,0" SelectionChanged="Quality_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Trim -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Height="30">
                    <CheckBox x:Name="TrimOption" Content="Recortar" VerticalAlignment="Center" Style="{StaticResource DarkCheckBox}"
                              Checked="Trim_Changed" Unchecked="Trim_Changed"/>
                    <StackPanel x:Name="TrimPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                        <TextBlock Text="Desde" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TrimStartBox" Width="74" Height="30" Margin="6,0,10,0" FontSize="13" ToolTip="Ej. 1:20 (vacío = inicio)"/>
                        <TextBlock Text="Hasta" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TrimEndBox" Width="74" Height="30" Margin="6,0,0,0" FontSize="13" ToolTip="Ej. 2:45 (vacío = final)"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="DownloadButton"
                        Margin="0,14,0,0"
                        Content="Descargar"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Download_Click"/>

                <TextBlock x:Name="HintText" Margin="0,8,0,0" FontSize="12" Visibility="Collapsed"
                           Foreground="#F2A0A3" TextWrapping="Wrap"/>

                <TextBlock x:Name="EmptyHint" Margin="0,12,0,0" FontSize="12" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Copia un enlace y se pegará solo. Puedes añadir varios a la cola."/>

                <!-- Queue -->
                <Border x:Name="QueuePanel"
                        Visibility="Collapsed"
                        Margin="0,12,0,0"
                        CornerRadius="7"
                        Background="{StaticResource StatusBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,8,8,4">
                            <TextBlock Text="Descargas" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Content="Limpiar terminadas" Style="{StaticResource LinkButtonStyle}" Click="ClearFinished_Click"/>
                        </Grid>
                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Status, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <ProgressBar Margin="0,6,0,0" Height="4"
                                                                 Value="{Binding Percent, Mode=OneWay}"
                                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button Content="📂" ToolTip="Mostrar archivo" Style="{StaticResource IconButtonStyle}"
                                                            Visibility="{Binding CanShowFile, Converter={StaticResource BoolToVis}}"
                                                            Click="QueueItemShow_Click"/>
                                                    <Button Content="✕" ToolTip="Cancelar / quitar" Style="{StaticResource IconButtonStyle}"
                                                            Click="QueueItemAction_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Output folder -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Guardar en:" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="ChangeFolderButton"
                            Grid.Column="1"
                            Margin="6,0,10,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="ChangeFolder_Click">
                        <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis" TextDecorations="Underline"/>
                    </Button>
                    <Button Grid.Column="2"
                            Width="110"
                            Content="Abrir carpeta"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenFolder_Click"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
